# Copy to config/site.env and customize (gitignored).
# Required before: ./scripts/setup-local.sh, docker compose up, deploy scripts.

# --- Deploy ---
ENERGY_REMOTE_HOST=user@192.168.1.50
ENERGY_REMOTE_DIR=/home/user/workspace/energy-stack
HA_SSH_USER=halil
HA_SSH_HOST=ha
HA_SSH_PORT=22

# HA Container (Docker Compose) — not HAOS Supervisor paths
# Prefer /opt/homeassistant once owned by the deploy user (one-time sudo).
# If /opt is not writable yet, use a home-dir layout instead, e.g.:
#   HA_CONFIG_DIR=/home/halil/homeassistant/config
#   HA_COMPOSE_DIR=/home/halil/homeassistant
HA_CONFIG_DIR=/opt/homeassistant/config
HA_COMPOSE_DIR=/opt/homeassistant
# Or set an explicit compose file (overrides HA_COMPOSE_DIR):
# HA_COMPOSE_FILE=/opt/homeassistant/docker-compose.yml
HA_CONTAINER_NAME=homeassistant

# --- Home Assistant entity contract (rendered into HA packages) ---
ENVOY_PV_ENTITY=sensor.envoy_CHANGE_ME_current_power_production
SIGEN_PLANT_SLUG=sigen_0
P1_POWER_NET_ENTITY=sensor.electricity_meter_power_net
P1_POWER_CONSUMPTION_ENTITY=sensor.electricity_meter_power_consumption
P1_POWER_PRODUCTION_ENTITY=sensor.electricity_meter_power_production
ZONNEPLAN_PRICE_SENSOR=sensor.zonneplan_current_electricity_tariff
EMHASS_SOC_SENSOR=sensor.sigen_0_plant_battery_soc
EMHASS_SOC_MIN_SENSOR=input_number.emhass_soc_min
EMHASS_SOC_MAX_SENSOR=input_number.emhass_soc_max

# --- Sigenergy / MQTT (rendered into sigenergy2mqtt.yaml) ---
SIGENERGY_MODBUS_HOST=192.168.1.10
SIGENERGY_MODBUS_SLAVE=247

# --- EMHASS / Open-Meteo site location ---
# Copy latitude, longitude, elevation, and timezone from HA Settings > System > General.
LAT=CHANGE_ME
LON=CHANGE_ME
ALT=CHANGE_ME
TIME_ZONE=Europe/Amsterdam

# --- Docker compose (emhass-cron, energy-monitor) ---
TZ=Europe/Amsterdam
EXPORT_PRICE_HAIRCUT_EUR_PER_KWH=0.04
