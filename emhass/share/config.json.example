  "sensor_replace_zero": [
    "sensor.emhass_pv_power_w"
  ],
  "sensor_linear_interp": [
    "sensor.emhass_pv_power_w",
    "sensor.emhass_house_load_power_w"
  ],
  "use_websocket": false,
