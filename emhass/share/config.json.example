  "load_offpeak_hours_cost": 0.15,
  "production_price_forecast_method": "csv",
  "photovoltaic_production_sell_price": 0.10,
  "maximum_power_from_grid": 5000,
  "maximum_power_to_grid": 5000,
  "set_use_pv": true,
  "set_use_adjusted_pv": false,
